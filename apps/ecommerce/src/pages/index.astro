---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  
  <style>
    :root {
      --bg-cream: #f6eedb;
      --bg-cream-dark: #ecd9bd;
      --card-white: #ffffff;
      --red-primary: #b91c1c;
      --red-dark: #991b1b;
      --red-crimson: #a81919;
      --yellow-accent: #fbb314;
      --yellow-hover: #e59f07;
      --yellow-card: #eab308;
      --sand-card: #e2d5c3;
      --text-dark: #1c1917;
      --text-muted: #64748b;
      --text-cream: #fbf5ea;
      --shadow-soft: 0 12px 30px rgba(0, 0, 0, 0.06);
      --shadow-card: 0 18px 40px rgba(0, 0, 0, 0.08);
      --shadow-pill: 0 10px 25px rgba(0, 0, 0, 0.12);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
      background-color: var(--bg-cream);
      color: var(--text-dark);
      line-height: 1.5;
      overflow-x: hidden;
    }

    /* ----------------------------------------------------
       HERO RED SECTION
       ---------------------------------------------------- */
    .hero-wrapper {
      background: linear-gradient(180deg, #b91c1c 0%, #a81919 75%, #991b1b 100%);
      color: #ffffff;
      padding-bottom: 3.5rem;
      position: relative;
    }

    /* Top Navigation inside Red Hero */
    .navbar {
      max-width: 1180px;
      margin: 0 auto;
      padding: 1.25rem 1.5rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .brand-logo {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      text-decoration: none;
      color: #ffffff;
    }
    .brand-icon-wrap {
      width: 38px;
      height: 38px;
      background: rgba(255, 255, 255, 0.2);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.2rem;
    }
    .brand-title {
      font-size: 1.25rem;
      font-weight: 900;
      letter-spacing: -0.02em;
      color: #ffffff;
      text-transform: uppercase;
    }

    .nav-links {
      display: flex;
      gap: 1.5rem;
      align-items: center;
    }
    .nav-link {
      color: rgba(255, 255, 255, 0.9);
      text-decoration: none;
      font-weight: 600;
      font-size: 0.9rem;
      transition: color 0.15s;
    }
    .nav-link:hover {
      color: var(--yellow-accent);
    }

    .btn-pill-yellow {
      background-color: var(--yellow-accent);
      color: #1c1917;
      border: none;
      padding: 0.65rem 1.5rem;
      border-radius: 9999px;
      font-weight: 800;
      font-size: 0.88rem;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      cursor: pointer;
      transition: transform 0.2s, background-color 0.2s;
      box-shadow: 0 4px 12px rgba(251, 179, 20, 0.35);
    }
    .btn-pill-yellow:hover {
      background-color: var(--yellow-hover);
      transform: translateY(-2px);
    }

    /* Hero Main Body */
    .hero-content {
      max-width: 1180px;
      margin: 0 auto;
      padding: 2.5rem 1.5rem 2rem;
      display: grid;
      grid-template-columns: 1.05fr 0.95fr;
      gap: 2.5rem;
      align-items: center;
      position: relative;
    }
    .hero-kicker {
      color: var(--yellow-accent);
      font-weight: 800;
      font-size: 0.95rem;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      margin-bottom: 0.75rem;
      display: flex;
      align-items: center;
      gap: 0.4rem;
    }
    .hero-title {
      font-size: 3.8rem;
      font-weight: 900;
      line-height: 1.05;
      letter-spacing: -0.03em;
      color: #ffffff;
      margin-bottom: 1.25rem;
      position: relative;
    }
    .hero-title .yellow-arrow {
      color: var(--yellow-accent);
      font-weight: 800;
      margin-left: 0.25rem;
      display: inline-block;
      font-size: 3rem;
    }
    .hero-desc {
      color: rgba(255, 255, 255, 0.88);
      font-size: 1.05rem;
      line-height: 1.6;
      margin-bottom: 2rem;
      max-width: 480px;
    }

    /* Hero Right Burger Showcase */
    .hero-image-wrap {
      position: relative;
      display: flex;
      justify-content: center;
      align-items: center;
    }
    .sparkle-icon {
      position: absolute;
      color: var(--yellow-accent);
      font-size: 1.8rem;
      user-select: none;
      animation: pulse 2.5s infinite ease-in-out;
    }
    .sparkle-1 { top: 10%; right: 15%; font-size: 2rem; }
    .sparkle-2 { bottom: 25%; left: 8%; font-size: 1.5rem; }
    .sparkle-3 { top: 35%; left: 5%; font-size: 1.3rem; }
    @keyframes pulse {
      0%, 100% { transform: scale(1); opacity: 0.85; }
      50% { transform: scale(1.25); opacity: 1; }
    }

    .hero-burger-img {
      width: 100%;
      max-width: 460px;
      height: 380px;
      object-fit: cover;
      border-radius: 50% 50% 45% 45% / 25% 25% 35% 35%;
      border: 8px solid rgba(255, 255, 255, 0.15);
      box-shadow: 0 25px 50px rgba(0, 0, 0, 0.35);
      transform: rotate(-1deg);
      transition: transform 0.3s ease;
    }
    .hero-burger-img:hover {
      transform: scale(1.02) rotate(0deg);
    }

    /* Floating White Pill Banner at Hero Bottom */
    .floating-pill-container {
      max-width: 980px;
      margin: 1.5rem auto -2.5rem;
      background: rgba(255, 255, 255, 0.96);
      backdrop-filter: blur(10px);
      border-radius: 9999px;
      padding: 0.85rem 2rem;
      box-shadow: var(--shadow-pill);
      display: flex;
      justify-content: space-between;
      align-items: center;
      position: relative;
      z-index: 20;
      border: 1px solid rgba(255, 255, 255, 0.8);
    }
    .pill-item {
      display: flex;
      align-items: center;
      gap: 0.85rem;
    }
    .pill-icon {
      font-size: 1.8rem;
    }
    .pill-text h4 {
      font-size: 0.85rem;
      font-weight: 800;
      color: #1c1917;
      text-transform: uppercase;
      letter-spacing: 0.02em;
      line-height: 1.2;
    }
    .pill-text p {
      font-size: 0.72rem;
      color: var(--text-muted);
      font-weight: 500;
    }
    .pill-divider {
      width: 1px;
      height: 32px;
      background: #e7e2d9;
    }

    /* ----------------------------------------------------
       MIDDLE SECTION: RED CARD "Order Fast Food in Minutes"
       ---------------------------------------------------- */
    .middle-banner-section {
      max-width: 1140px;
      margin: 5.5rem auto 3rem;
      padding: 0 1.5rem;
    }
    .middle-banner-card {
      background: linear-gradient(135deg, #b91c1c 0%, #991b1b 100%);
      border-radius: 32px;
      padding: 2.5rem 3.5rem;
      color: #ffffff;
      display: grid;
      grid-template-columns: 1.1fr 0.9fr;
      gap: 2rem;
      align-items: center;
      box-shadow: 0 20px 45px rgba(185, 28, 28, 0.25);
      position: relative;
      overflow: hidden;
    }
    .middle-title {
      font-size: 2.6rem;
      font-weight: 900;
      line-height: 1.1;
      letter-spacing: -0.02em;
      margin-bottom: 0.75rem;
    }
    .middle-desc {
      color: rgba(255, 255, 255, 0.88);
      font-size: 0.95rem;
      line-height: 1.6;
      margin-bottom: 1.75rem;
      max-width: 440px;
    }
    .middle-img-wrap {
      display: flex;
      justify-content: center;
      align-items: center;
      position: relative;
    }
    .middle-burger-img {
      width: 100%;
      max-width: 320px;
      height: 240px;
      object-fit: cover;
      border-radius: 24px;
      box-shadow: 0 15px 35px rgba(0, 0, 0, 0.3);
    }

    /* ----------------------------------------------------
       CATALOG SECTION: BIG WHITE CONTAINER CARD
       ---------------------------------------------------- */
    .catalog-section {
      max-width: 1140px;
      margin: 0 auto 4rem;
      padding: 0 1.5rem;
    }
    .catalog-white-box {
      background: #ffffff;
      border-radius: 36px;
      padding: 3.5rem 3rem;
      box-shadow: var(--shadow-card);
    }
    .catalog-header {
      text-align: center;
      margin-bottom: 2.5rem;
    }
    .catalog-kicker {
      color: var(--red-primary);
      font-size: 1.1rem;
      font-weight: 900;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      margin-bottom: 0.4rem;
    }
    .catalog-title {
      font-size: 2.5rem;
      font-weight: 900;
      letter-spacing: -0.02em;
      color: #1c1917;
      margin-bottom: 0.75rem;
    }
    .catalog-subtitle {
      color: var(--text-muted);
      font-size: 0.95rem;
      max-width: 620px;
      margin: 0 auto;
    }

    /* Category filter tabs */
    .filter-tabs {
      display: flex;
      justify-content: center;
      gap: 0.6rem;
      flex-wrap: wrap;
      margin-bottom: 3rem;
    }
    .filter-btn {
      background: #fbf8f2;
      border: 1.5px solid #ecd9bd;
      color: #78716c;
      font-family: inherit;
      font-weight: 700;
      font-size: 0.85rem;
      padding: 0.5rem 1.2rem;
      border-radius: 9999px;
      cursor: pointer;
      transition: all 0.2s;
    }
    .filter-btn.active, .filter-btn:hover {
      background: var(--red-primary);
      color: #ffffff;
      border-color: var(--red-primary);
    }

    /* 3-Column Burger Cards Grid with Colored Frames */
    .burger-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
    }
    .burger-card {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      transition: transform 0.2s ease;
    }
    .burger-card:hover {
      transform: translateY(-6px);
    }

    /* Colorful Framed Background Container as in image */
    .burger-frame {
      width: 100%;
      height: 240px;
      border-radius: 24px;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      overflow: hidden;
      margin-bottom: 1.1rem;
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08);
    }
    .burger-frame.frame-red {
      background: linear-gradient(135deg, #a81919 0%, #881313 100%);
    }
    .burger-frame.frame-yellow {
      background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
    }
    .burger-frame.frame-sand {
      background: linear-gradient(135deg, #e7dbcd 0%, #d5c3af 100%);
    }

    .burger-frame-img {
      width: 86%;
      height: 86%;
      object-fit: cover;
      border-radius: 18px;
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.2);
      transition: transform 0.3s ease;
    }
    .burger-card:hover .burger-frame-img {
      transform: scale(1.05);
    }

    .burger-name {
      font-size: 1.15rem;
      font-weight: 900;
      color: #1c1917;
      text-transform: uppercase;
      letter-spacing: -0.01em;
      margin-bottom: 0.4rem;
    }
    .badge-pill-red {
      background: var(--red-primary);
      color: #ffffff;
      padding: 0.3rem 0.9rem;
      border-radius: 9999px;
      font-size: 0.75rem;
      font-weight: 800;
      letter-spacing: 0.02em;
      display: inline-block;
      margin-bottom: 0.75rem;
    }
    .burger-card-price {
      font-size: 1.25rem;
      font-weight: 900;
      color: var(--red-primary);
      margin-bottom: 0.85rem;
    }
    .btn-detail-outline {
      background: #ffffff;
      border: 1.5px solid #ecd9bd;
      color: #1c1917;
      font-family: inherit;
      padding: 0.5rem 1.2rem;
      border-radius: 9999px;
      font-weight: 700;
      font-size: 0.82rem;
      cursor: pointer;
      transition: all 0.2s;
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
    }
    .btn-detail-outline:hover {
      background: var(--yellow-accent);
      border-color: var(--yellow-accent);
      color: #1c1917;
    }

    /* ----------------------------------------------------
       BOTTOM SIDES SHOWCASE & FOOTER
       ---------------------------------------------------- */
    .bottom-sides-section {
      max-width: 1140px;
      margin: 0 auto 3rem;
      text-align: center;
      padding: 0 1.5rem;
    }
    .sides-title {
      font-size: 1.1rem;
      font-weight: 900;
      color: var(--red-primary);
      text-transform: uppercase;
      margin-bottom: 1.5rem;
    }
    .sides-row {
      display: flex;
      justify-content: center;
      gap: 3.5rem;
      flex-wrap: wrap;
    }
    .side-item {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.5rem;
    }
    .side-item img {
      width: 90px;
      height: 90px;
      object-fit: cover;
      border-radius: 50%;
      border: 4px solid #ffffff;
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1);
    }
    .side-item span {
      font-size: 0.85rem;
      font-weight: 800;
      color: #1c1917;
      text-transform: uppercase;
    }

    .yellow-bottom-bar {
      background: var(--yellow-accent);
      color: #1c1917;
      padding: 1rem 1.5rem;
      text-align: center;
      font-weight: 800;
      font-size: 0.95rem;
      letter-spacing: 0.02em;
    }
    footer {
      background: #1c1917;
      color: #fbf5ea;
      padding: 2.5rem 1.5rem 1.5rem;
      text-align: center;
    }
    .footer-links {
      display: flex;
      justify-content: center;
      gap: 1.5rem;
      margin-bottom: 1.25rem;
      flex-wrap: wrap;
    }
    .footer-links a {
      color: #fbf5ea;
      text-decoration: none;
      font-size: 0.88rem;
      font-weight: 600;
    }
    .footer-links a:hover {
      color: var(--yellow-accent);
    }

    /* ----------------------------------------------------
       MODAL FOR BURGER DETAILS
       ---------------------------------------------------- */
    .modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(28, 25, 23, 0.7);
      backdrop-filter: blur(6px);
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 100;
      padding: 1.5rem;
    }
    .modal-overlay.active {
      display: flex;
    }
    .modal-card {
      background: #ffffff;
      border-radius: 28px;
      max-width: 650px;
      width: 100%;
      max-height: 90vh;
      overflow-y: auto;
      box-shadow: 0 30px 60px rgba(0,0,0,0.3);
      position: relative;
      animation: modalPop 0.25s ease-out;
    }
    @keyframes modalPop {
      from { transform: scale(0.95); opacity: 0; }
      to { transform: scale(1); opacity: 1; }
    }
    .modal-close {
      position: absolute;
      top: 16px;
      right: 16px;
      width: 36px;
      height: 36px;
      background: rgba(255, 255, 255, 0.9);
      border: 1px solid #e7e2d9;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.2rem;
      cursor: pointer;
      z-index: 10;
      color: #1c1917;
    }
    .modal-header-img {
      width: 100%;
      height: 250px;
      object-fit: cover;
      border-radius: 28px 28px 0 0;
    }
    .modal-body {
      padding: 2rem;
    }
    .modal-badge-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 0.75rem;
    }
    .modal-title {
      font-size: 1.85rem;
      font-weight: 900;
      color: #1c1917;
      margin-bottom: 0.5rem;
    }
    .modal-price {
      font-size: 1.85rem;
      font-weight: 900;
      color: var(--red-primary);
    }
    .modal-desc {
      color: #64748b;
      font-size: 0.95rem;
      line-height: 1.6;
      margin-bottom: 1.5rem;
    }
    .specs-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1rem;
      background: #faf7f2;
      border: 1px solid #e7e2d9;
      border-radius: 14px;
      padding: 1rem;
      margin-bottom: 1.5rem;
      text-align: center;
    }
    .spec-box small {
      display: block;
      color: #a8a29e;
      font-size: 0.72rem;
      font-weight: 700;
      text-transform: uppercase;
    }
    .spec-box span {
      font-size: 0.95rem;
      font-weight: 800;
      color: #1c1917;
    }
    .ingredients-box {
      margin-bottom: 1.5rem;
    }
    .ingredients-title {
      font-size: 0.9rem;
      font-weight: 800;
      color: #1c1917;
      margin-bottom: 0.5rem;
    }
    .ingredients-list {
      list-style: none;
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 0.4rem;
    }
    .ingredients-list li {
      font-size: 0.85rem;
      color: #64748b;
      display: flex;
      align-items: center;
      gap: 0.4rem;
    }
    .ingredients-list li::before {
      content: "✔";
      color: #16a34a;
      font-size: 0.75rem;
      font-weight: 800;
    }
    .modal-actions {
      display: flex;
      gap: 1rem;
    }

    @media (max-width: 990px) {
      .hero-content, .middle-banner-card {
        grid-template-columns: 1fr;
      }
      .hero-title {
        font-size: 2.8rem;
      }
      .burger-grid {
        grid-template-columns: repeat(2, 1fr);
      }
      .floating-pill-container {
        flex-direction: column;
        border-radius: 24px;
        gap: 1rem;
        margin: 1.5rem auto 1.5rem;
      }
      .pill-divider { display: none; }
    }
    @media (max-width: 640px) {
      .hero-title {
        font-size: 2.2rem;
      }
      .burger-grid {
        grid-template-columns: 1fr;
      }
      .nav-links { display: none; }
      .catalog-white-box { padding: 2rem 1.25rem; }
    }
  </style>
</head>
<body>

  <!-- HERO RED SECTION -->
  <section class="hero-wrapper">
    <!-- Navbar -->
    <header class="navbar">
      <a href="/" class="brand-logo">
        <div class="brand-icon-wrap">📍</div>
        <span class="brand-title">Hamburger Rapid</span>
      </a>

      <nav class="nav-links">
        <a href="/" class="nav-link">Inicio</a>
        <a href="/app" class="nav-link">Delivery PWA</a>
        <a href="#catalogo" class="nav-link">Catálogo</a>
        <a href="#combos" class="nav-link">Combos</a>
        <a href="/admin" class="nav-link">Panel Admin</a>
      </nav>

      <a href="/app" class="btn-pill-yellow">
        <span>📲</span> Pedir Ahora
      </a>
    </header>

    <!-- Hero Content -->
    <div class="hero-content">
      <div>
        <div class="hero-kicker">
          <span>✨</span> HAMBURGER RAPID ESPECIAL
        </div>
        <h1 class="hero-title">
          Order Your<br/>Favorites <span class="yellow-arrow">&gt;</span>
        </h1>
        <p class="hero-desc">
          Carne 100% Angus certificada a la brasa, queso fundido, vegetales frescos de huerta y pan brioche horneado a diario con entrega express en minutos.
        </p>
        <a href="#catalogo" class="btn-pill-yellow" style="padding: 0.85rem 2rem; font-size: 0.95rem;">
          EXPLORAR MENÚ
        </a>
      </div>

      <!-- Right Burger with Sparkles -->
      <div class="hero-image-wrap">
        <span class="sparkle-icon sparkle-1">✦</span>
        <span class="sparkle-icon sparkle-2">✦</span>
        <span class="sparkle-icon sparkle-3">★</span>
        <img
          src="https://images.unsplash.com/photo-1568901346375-23c9450c58cd?w=700&auto=format&fit=crop&q=80"
          alt="Rey de las Burgers"
          class="hero-burger-img"
        />
      </div>
    </div>
  </section>

  <!-- OVERLAPPING FLOATING PILL CONTAINER -->
  <div class="floating-pill-container" id="combos">
    <div class="pill-item">
      <span class="pill-icon">🚖</span>
      <div class="pill-text">
        <h4>COMBOS EXPRESS</h4>
        <p>Ahorra hasta 25% con menú completo</p>
      </div>
    </div>

    <div class="pill-divider"></div>

    <div class="pill-item">
      <span class="pill-icon">🥤</span>
      <div class="pill-text">
        <h4>BEBIDAS & SIDES</h4>
        <p>Papas rústicas y malteadas</p>
      </div>
    </div>

    <div class="pill-divider"></div>

    <a href="/app" class="btn-pill-yellow">
      ORDENAR AHORA
    </a>
  </div>

  <!-- MIDDLE RED CARD BANNER -->
  <section class="middle-banner-section">
    <div class="middle-banner-card">
      <div>
        <h2 class="middle-title">
          Order Fast Food<br/>in Minutes <span style="color: var(--yellow-accent);">&gt;</span>
        </h2>
        <p class="middle-desc">
          Pide desde tu smartphone con nuestra aplicación móvil PWA interactiva con seguimiento de cocina y despacho en tiempo real.
        </p>
        <a href="/app" class="btn-pill-yellow" style="padding: 0.75rem 1.6rem;">
          ABRIR APP PWA
        </a>
      </div>

      <div class="middle-img-wrap">
        <span class="sparkle-icon sparkle-1">✦</span>
        <img
          src="https://images.unsplash.com/photo-1550547660-d9450f859349?w=600&auto=format&fit=crop&q=80"
          alt="Burger Real Doble"
          class="middle-burger-img"
        />
      </div>
    </div>
  </section>

  <!-- CATALOG SECTION: WHITE ROUNDED CONTAINER -->
  <section id="catalogo" class="catalog-section">
    <div class="catalog-white-box">
      <div class="catalog-header">
        <div class="catalog-kicker">ESPECIALIDADES DE AUTOR</div>
        <h2 class="catalog-title">Catálogo de 10 Variantes Destacadas</h2>
        <p class="catalog-subtitle">
          Descubre nuestras opciones clásicas y recetas especiales preparadas al fuego vivo con los más selectos ingredientes gourmet.
        </p>
      </div>

      <!-- Categories Filter Tabs -->
      <div class="filter-tabs">
        <button class="filter-btn active" data-category="all">Todas (10)</button>
        <button class="filter-btn" data-category="Especiales">Especiales de Autor</button>
        <button class="filter-btn" data-category="Clásicas">Clásicas Maestras</button>
        <button class="filter-btn" data-category="Pollo & Crispy">Pollo & Crispy</button>
        <button class="filter-btn" data-category="Picantes">Picantes al Fuego</button>
        <button class="filter-btn" data-category="Vegetarianas">Vegetarianas</button>
      </div>

      <!-- 3-Column Grid of 10 Burgers -->
      <div class="burger-grid">
        {burgers.map((burger) => (
          <article class="burger-card" data-category={burger.category}>
            <!-- Colorful Framed Background Container -->
            <div class={`burger-frame ${burger.frameColor}`}>
              <img
                src={burger.image}
                alt={burger.name}
                class="burger-frame-img"
                loading="lazy"
              />
            </div>

            <h3 class="burger-name">{burger.name}</h3>
            
            <div class="badge-pill-red">
              {burger.specialtyLevel}
            </div>

            <div class="burger-card-price">
              ${burger.price.toFixed(2)}
            </div>

            <button
              class="btn-detail-outline open-modal-btn"
              data-burger={JSON.stringify(burger)}
            >
              <span>👁️</span> Ver Detalles
            </button>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- BOTTOM SIDES SHOWCASE -->
  <section class="bottom-sides-section">
    <div class="sides-title">🍟 Complementos & Bebidas Artesanales</div>
    <div class="sides-row">
      <div class="side-item">
        <img src="https://images.unsplash.com/photo-1576107232684-1279f3908594?w=200&auto=format&fit=crop&q=80" alt="Papas Fritas" />
        <span>Papas Rústicas</span>
      </div>
      <div class="side-item">
        <img src="https://images.unsplash.com/photo-1639024471287-032f66e5a072?w=200&auto=format&fit=crop&q=80" alt="Aros de Cebolla" />
        <span>Aros de Cebolla</span>
      </div>
      <div class="side-item">
        <img src="https://images.unsplash.com/photo-1551024709-8f23befc6f87?w=200&auto=format&fit=crop&q=80" alt="Bebidas" />
        <span>Bebidas Heladas</span>
      </div>
    </div>
  </section>

  <!-- Yellow Bottom Accent Bar -->
  <div class="yellow-bottom-bar">
    ⚡ Hamburger Rapid &bull; Entrega Express a Domicilio en Menos de 18 Minutos
  </div>

  <!-- Footer -->
  <footer>
    <div class="footer-links">
      <a href="/">Inicio</a>
      <a href="/app">📱 App Móvil PWA</a>
      <a href="/admin">⚙️ Panel Admin</a>
      <a href="/api/products">📦 API Catálogo</a>
      <a href="/api/health">🩺 Health Check</a>
    </div>
    <p style="font-size: 0.8rem; color: #a8a29e;">
      &copy; 2026 Hamburger Rapid &bull; Todos los derechos reservados.
    </p>
  </footer>

  <!-- Modal for Burger Details -->
  <div id="burger-modal" class="modal-overlay">
    <div class="modal-card">
      <button id="modal-close" class="modal-close">&times;</button>
      <img id="modal-img" class="modal-header-img" src="" alt="Burger Detail" />
      
      <div class="modal-body">
        <div class="modal-badge-row">
          <span id="modal-badge" class="badge-pill-red">👑 Especialidad</span>
          <span id="modal-category" style="font-size: 0.85rem; font-weight: 800; color: var(--red-primary);">CATEGORIA</span>
        </div>

        <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.5rem;">
          <h2 id="modal-title" class="modal-title">Título de Hamburguesa</h2>
          <span id="modal-price" class="modal-price">$0.00</span>
        </div>

        <p id="modal-desc" class="modal-desc">Descripción completa</p>

        <!-- Nutritional & Timing Specs -->
        <div class="specs-grid">
          <div class="spec-box">
            <small>Preparación</small>
            <span id="modal-time">10 min</span>
          </div>
          <div class="spec-box">
            <small>Calorías</small>
            <span id="modal-calories">750 kcal</span>
          </div>
          <div class="spec-box">
            <small>Proteínas</small>
            <span id="modal-protein">45g</span>
          </div>
        </div>

        <!-- Ingredients List -->
        <div class="ingredients-box">
          <div class="ingredients-title">Ingredientes e Insumos Seleccionados:</div>
          <ul id="modal-ingredients" class="ingredients-list">
          </ul>
        </div>

        <!-- Recommended Pairing -->
        <div style="background: #fffbeb; border: 1px solid #fef3c7; padding: 0.85rem 1.15rem; border-radius: 12px; margin-bottom: 1.5rem; font-size: 0.85rem; color: #92400e;">
          <strong>Maridaje Sugerido:</strong> <span id="modal-pairing">Papas trufadas y Cerveza IPA</span>
        </div>

        <div class="modal-actions">
          <a id="modal-pwa-link" href="/app" class="btn-pill-yellow" style="flex: 2; justify-content: center; padding: 0.85rem;">
            📱 Ordenar esta Burger en PWA
          </a>
          <button id="modal-close-btn" class="btn-detail-outline" style="flex: 1; justify-content: center; padding: 0.85rem;">
            Cerrar
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Interactive JavaScript for Modals and Filters -->
  <script is:inline>
    // Category Filtering
    const filterButtons = document.querySelectorAll('.filter-btn');
    const burgerCards = document.querySelectorAll('.burger-card');

    filterButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        filterButtons.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        const selectedCategory = btn.getAttribute('data-category');
        burgerCards.forEach(card => {
          if (selectedCategory === 'all' || card.getAttribute('data-category') === selectedCategory) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });

    // Details Modal Logic
    const modal = document.getElementById('burger-modal');
    const modalClose = document.getElementById('modal-close');
    const modalCloseBtn = document.getElementById('modal-close-btn');

    const modalImg = document.getElementById('modal-img');
    const modalBadge = document.getElementById('modal-badge');
    const modalCategory = document.getElementById('modal-category');
    const modalTitle = document.getElementById('modal-title');
    const modalPrice = document.getElementById('modal-price');
    const modalDesc = document.getElementById('modal-desc');
    const modalTime = document.getElementById('modal-time');
    const modalCalories = document.getElementById('modal-calories');
    const modalProtein = document.getElementById('modal-protein');
    const modalIngredients = document.getElementById('modal-ingredients');
    const modalPairing = document.getElementById('modal-pairing');
    const modalPwaLink = document.getElementById('modal-pwa-link');

    document.querySelectorAll('.open-modal-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const data = JSON.parse(btn.getAttribute('data-burger'));

        modalImg.src = data.image;
        modalImg.alt = data.name;
        modalBadge.textContent = data.specialtyLevel;
        modalCategory.textContent = data.category.toUpperCase();
        modalTitle.textContent = data.name;
        modalPrice.textContent = `$${data.price.toFixed(2)}`;
        modalDesc.textContent = data.fullDesc;
        modalTime.textContent = data.prepTime;
        modalCalories.textContent = data.calories;
        modalProtein.textContent = data.protein;
        modalPairing.textContent = data.pairing;
        modalPwaLink.href = `/app?burgerId=${data.id}`;

        modalIngredients.innerHTML = '';
        data.ingredients.forEach(ing => {
          const li = document.createElement('li');
          li.textContent = ing;
          modalIngredients.appendChild(li);
        });

        modal.classList.add('active');
        document.body.style.overflow = 'hidden';
      });
    });

    function closeModal() {
      modal.classList.remove('active');
      document.body.style.overflow = 'auto';
    }

    modalClose.addEventListener('click', closeModal);
    modalCloseBtn.addEventListener('click', closeModal);
    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal.classList.contains('active')) {
        closeModal();
      }
    });
  </script>
</body>
</html>
