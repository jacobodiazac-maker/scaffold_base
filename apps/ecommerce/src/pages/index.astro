<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Cabinet+Grotesk:wght@700;800;900&display=swap" rel="stylesheet">
  
  <style>
    :root {
      --bg: #faf9f6;
      --surface: #ffffff;
      --surface-subtle: #f4efe6;
      --border: #e7e2d9;
      --border-focus: #d97706;
      --text: #1c1917;
      --text-muted: #78716c;
      --text-subtle: #a8a29e;
      --primary: #c2410c;
      --primary-hover: #9a3412;
      --primary-subtle: #ffedd5;
      --accent-gold: #d97706;
      --accent-gold-subtle: #fef3c7;
      --shadow-sm: 0 2px 8px -2px rgba(28, 25, 23, 0.05);
      --shadow-md: 0 12px 24px -4px rgba(28, 25, 23, 0.08), 0 4px 8px -2px rgba(28, 25, 23, 0.04);
      --shadow-lg: 0 20px 40px -8px rgba(28, 25, 23, 0.12), 0 8px 16px -4px rgba(28, 25, 23, 0.06);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
      background-color: var(--bg);
      color: var(--text);
      line-height: 1.6;
      overflow-x: hidden;
    }

    /* Top bar */
    .top-promo {
      background: linear-gradient(90deg, #9a3412, #c2410c, #b45309);
      color: #ffffff;
      text-align: center;
      padding: 0.5rem 1rem;
      font-size: 0.85rem;
      font-weight: 600;
      letter-spacing: 0.02em;
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 0.5rem;
    }

    /* Navbar */
    .navbar {
      background: rgba(255, 255, 255, 0.92);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--border);
      position: sticky;
      top: 0;
      z-index: 50;
      transition: all 0.2s ease;
    }
    .nav-container {
      max-width: 1240px;
      margin: 0 auto;
      padding: 1rem 1.5rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .brand {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      text-decoration: none;
      color: var(--text);
    }
    .brand-icon {
      width: 44px;
      height: 44px;
      background: linear-gradient(135deg, #c2410c, #ea580c);
      color: white;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.6rem;
      box-shadow: 0 4px 12px rgba(194, 65, 12, 0.25);
    }
    .brand-text h2 {
      font-size: 1.35rem;
      font-weight: 800;
      letter-spacing: -0.02em;
      color: #1c1917;
      line-height: 1;
    }
    .brand-text span {
      font-size: 0.72rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--primary);
    }

    .nav-links {
      display: flex;
      gap: 1.5rem;
      align-items: center;
    }
    .nav-link {
      text-decoration: none;
      color: var(--text-muted);
      font-weight: 600;
      font-size: 0.95rem;
      transition: color 0.15s ease;
    }
    .nav-link:hover {
      color: var(--primary);
    }
    .nav-actions {
      display: flex;
      gap: 0.75rem;
      align-items: center;
    }

    .btn-outline {
      border: 1.5px solid var(--border);
      background: var(--surface);
      color: var(--text);
      padding: 0.6rem 1.1rem;
      border-radius: 10px;
      font-weight: 600;
      font-size: 0.9rem;
      text-decoration: none;
      transition: all 0.2s;
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
    }
    .btn-outline:hover {
      border-color: var(--text);
      background: #faf7f2;
    }

    .btn-primary {
      background: linear-gradient(135deg, #c2410c, #ea580c);
      color: white;
      border: none;
      padding: 0.65rem 1.3rem;
      border-radius: 10px;
      font-weight: 700;
      font-size: 0.9rem;
      text-decoration: none;
      transition: all 0.2s;
      box-shadow: 0 4px 14px rgba(194, 65, 12, 0.28);
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
    }
    .btn-primary:hover {
      transform: translateY(-1px);
      box-shadow: 0 8px 20px rgba(194, 65, 12, 0.35);
    }

    /* Hero */
    .hero {
      max-width: 1240px;
      margin: 0 auto;
      padding: 4rem 1.5rem 3rem;
      display: grid;
      grid-template-columns: 1.15fr 0.85fr;
      gap: 3rem;
      align-items: center;
    }
    .hero-tag {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      background: var(--primary-subtle);
      color: var(--primary);
      border: 1px solid rgba(194, 65, 12, 0.2);
      padding: 0.4rem 1rem;
      border-radius: 9999px;
      font-size: 0.82rem;
      font-weight: 700;
      margin-bottom: 1.25rem;
    }
    .hero-title {
      font-size: 3.6rem;
      font-weight: 800;
      letter-spacing: -0.03em;
      line-height: 1.08;
      color: #1c1917;
      margin-bottom: 1.25rem;
    }
    .hero-title span {
      background: linear-gradient(135deg, #c2410c, #b45309);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    .hero-subtitle {
      font-size: 1.2rem;
      color: var(--text-muted);
      line-height: 1.6;
      margin-bottom: 2rem;
      max-width: 560px;
    }
    .hero-cta {
      display: flex;
      gap: 1rem;
      flex-wrap: wrap;
      margin-bottom: 2.5rem;
    }
    .hero-stats {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.25rem;
      padding-top: 2rem;
      border-top: 1px solid var(--border);
    }
    .stat-item h3 {
      font-size: 1.6rem;
      font-weight: 800;
      color: #1c1917;
    }
    .stat-item p {
      font-size: 0.82rem;
      color: var(--text-muted);
      font-weight: 500;
    }

    .hero-banner-card {
      background: #ffffff;
      border: 1px solid var(--border);
      border-radius: 28px;
      padding: 1.5rem;
      box-shadow: var(--shadow-lg);
      position: relative;
    }
    .hero-banner-card img {
      width: 100%;
      height: 380px;
      object-fit: cover;
      border-radius: 20px;
    }
    .floating-card {
      position: absolute;
      bottom: -15px;
      left: -15px;
      background: #ffffff;
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 1rem 1.25rem;
      box-shadow: var(--shadow-md);
      display: flex;
      align-items: center;
      gap: 0.85rem;
      animation: float 4s ease-in-out infinite;
    }
    @keyframes float {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-8px); }
    }

    /* Catalog Section */
    .catalog-section {
      background: #ffffff;
      border-top: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
      padding: 5rem 1.5rem;
    }
    .catalog-container {
      max-width: 1240px;
      margin: 0 auto;
    }
    .section-header {
      text-align: center;
      max-width: 680px;
      margin: 0 auto 3rem;
    }
    .section-badge {
      display: inline-block;
      background: var(--accent-gold-subtle);
      color: var(--accent-gold);
      border: 1px solid rgba(217, 119, 6, 0.25);
      font-size: 0.8rem;
      font-weight: 700;
      padding: 0.35rem 0.9rem;
      border-radius: 9999px;
      margin-bottom: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }
    .section-title {
      font-size: 2.6rem;
      font-weight: 800;
      letter-spacing: -0.02em;
      color: #1c1917;
      margin-bottom: 0.75rem;
    }
    .section-subtitle {
      color: var(--text-muted);
      font-size: 1.05rem;
    }

    /* Filter buttons */
    .filter-tabs {
      display: flex;
      justify-content: center;
      gap: 0.6rem;
      flex-wrap: wrap;
      margin-bottom: 3rem;
    }
    .filter-btn {
      background: #faf7f2;
      border: 1px solid var(--border);
      color: var(--text-muted);
      font-family: inherit;
      font-weight: 600;
      font-size: 0.9rem;
      padding: 0.55rem 1.25rem;
      border-radius: 9999px;
      cursor: pointer;
      transition: all 0.2s;
    }
    .filter-btn.active, .filter-btn:hover {
      background: #1c1917;
      color: #ffffff;
      border-color: #1c1917;
    }

    /* Burgers Grid */
    .burger-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
      gap: 2rem;
    }
    .burger-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 22px;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      transition: all 0.25s ease;
      box-shadow: var(--shadow-sm);
      position: relative;
    }
    .burger-card:hover {
      transform: translateY(-5px);
      box-shadow: var(--shadow-lg);
      border-color: #d1c7b8;
    }
    .card-img-container {
      position: relative;
      width: 100%;
      height: 230px;
      overflow: hidden;
      background: #f4efe6;
    }
    .card-img-container img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.4s ease;
    }
    .burger-card:hover .card-img-container img {
      transform: scale(1.04);
    }

    /* Badges */
    .badge-specialty {
      position: absolute;
      top: 14px;
      left: 14px;
      padding: 0.4rem 0.85rem;
      border-radius: 9999px;
      font-size: 0.75rem;
      font-weight: 700;
      box-shadow: 0 4px 10px rgba(0,0,0,0.15);
      backdrop-filter: blur(8px);
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
    }
    .badge-specialty.amber {
      background: rgba(254, 243, 199, 0.95);
      color: #92400e;
      border: 1px solid rgba(217, 119, 6, 0.3);
    }
    .badge-specialty.emerald {
      background: rgba(209, 250, 229, 0.95);
      color: #065f46;
      border: 1px solid rgba(16, 185, 129, 0.3);
    }
    .badge-specialty.orange {
      background: rgba(255, 237, 213, 0.95);
      color: #9a3412;
      border: 1px solid rgba(234, 88, 12, 0.3);
    }
    .badge-specialty.purple {
      background: rgba(243, 232, 255, 0.95);
      color: #6b21a8;
      border: 1px solid rgba(168, 85, 247, 0.3);
    }
    .badge-specialty.red {
      background: rgba(254, 226, 226, 0.95);
      color: #991b1b;
